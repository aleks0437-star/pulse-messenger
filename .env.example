# Local development template. Replace every *SECRET value before deployment.
NODE_ENV=development
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_JWT_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
API_PORT=4000
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Development-only VAPID pair. Generate a unique production pair with: npx web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:admin@pulse.local
VAPID_PUBLIC_KEY=BN3m0wVDPKjh1tD4ZSZhro_7gYu7e2mayLxu01OSEEAlytRiV4S8fnr10-o38XuYNkAKOkOi9PWfE1sEiClPyt8
VAPID_PRIVATE_KEY=ZdpuJqeldYjWdyhv7bmtWHh7y33BPgpeTHJnUwrWcAg
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN3m0wVDPKjh1tD4ZSZhro_7gYu7e2mayLxu01OSEEAlytRiV4S8fnr10-o38XuYNkAKOkOi9PWfE1sEiClPyt8
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pulse-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_FORCE_PATH_STYLE=true
